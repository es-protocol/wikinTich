# Copy to `.env` and/or `.env.local` for local and Docker.
# Never commit real secrets.
#
# Docker: `docker compose` substitutes build args from `.env` by default. If you only
# use `.env.local`, run: `docker compose --env-file .env.local up --build`

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CSRF_SECRET=
SESSION_SECRET=

# Optional — CORS / redirects (see lib/cors-config.ts, lib/utils/redirect-url.ts)
PRODUCTION_URL=
STAGING_URL=
NEXT_PUBLIC_SITE_URL=
ADDITIONAL_ALLOWED_ORIGINS=

# Note: Server-side rate limits are defined in code (lib/server-rate-limiting.ts),
# not via env. Variables like RATE_LIMIT_WINDOW_MS in .env have no effect unless
# the code is changed to read them.

# Set at image build (Dockerfile ARG) or runtime for observability
GIT_SHA=

# CSP: omit on raw HTTP (Docker on IP). Vercel sets VERCEL=1 and keeps HTTPS upgrade behavior.
# CSP_HTTPS_UPGRADE=true

# Used by docker-compose (reserved for future Redis-backed rate limits / cache)
REDIS_URL=redis://redis:6379
